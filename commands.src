helpCommandHandler = function(params, extensionMediator)
    nullshellUi = extensionMediator.getExtension("nullshellUi")
    commandManager = extensionMediator.getExtension("commandManager")
    commandName = params.commandName

    if commandName != null then
        command = commandManager.getCommand(commandName)
        if command isa Error then return command
        hasPermission = commandManager.checkPermissions(command)
        hasPermission = not(hasPermission isa Error)
        result = {             "name": command.name,             "description": command.description,             "parameters": command.parameters,             "hasPermissions": hasPermission         }
        nullshellUi.helpSingle(result)
        return
    end if

    commandsList = []
    for command in commandManager.commands
        command = command.value
        hasPermissions = commandManager.checkPermissions(command)
        hasPermissions = not(hasPermissions isa Error)
        result = {             "name": command.name,             "description": command.description,             "parameters": command.parameters,             "hasPermissions": hasPermissions         }
        commandsList.push(result)
    end for
    nullshellUi.help(commandsList)
end function
commandManager.registerCommand(Command.New({     "name": "help",     "description": "Show help",     "parameters": [         Parameter.New({             "name": "commandName",             "required": false         })     ],     "callback": @helpCommandHandler }))

getPassCommandHandler = function(params, extensionMediator)
	nullshellUi = extensionMediator.getExtension("nullshellUi")
	sessionManager = extensionMediator.getExtension("sessionManager")
	session = sessionManager.currentSession
	handler = session.handler
	
	allHash = []
	objEntry = { "user" : "", "hash" : "", "password" : "" }
	fileContent = []
	dictionaryManager = extensionMediator.getExtension("dictionaryManager")
	
	GetEntry = function(line)
		thisUser = slice(line, 0, line.indexOf(":"))
		thisHash = slice(line, line.indexOf(":") + 1, line.len)
		thisPassword = "" 
		
		password = dictionaryManager.get()
		while not password isa Error
			if md5(password) == thisHash then 
				thisPassword = password
				break
			end if
					
			password = dictionaryManager.get()
		end while
	
		thisEntry = new objEntry
		thisEntry.user = thisUser
		thisEntry.hash = thisHash
		thisEntry.password = thisPassword
		
		dictionaryManager.reset
		
		return thisEntry
	end function
	
	path = "/etc/passwd"
	file = handler.getFile(path)
	if (not file isa Error) and (file.hasPermission("r")) then	
		fileContent = split(file.content, char(10))
		for line in fileContent
			if line.indexOf(":") != null then
				allHash.push(line)
			end if
		end for
	end if
	
	path = "/home"
	file = handler.getFile(path)
	if file isa Error then
		return file
	end if
	if file.children isa Error then
		return file.children
	end if

	userList = []	
	for child in file.children
		if child.name != "guest" then userList.push(child.name)
	end for
	
	for user in userList
		path = "/home/" + user + "/Config/Mail.txt"
		file = handler.getFile(path)
		if (not file isa Error) and (file.hasPermission("r")) then
			fileContent = split(file.content, char(10))
			for line in fileContent
				if line.indexOf(":") != null then
					allHash.push(line)
				end if
			end for
		end if
	
		path = "/home/" + user + "/Config/Bank.txt"
		file = handler.getFile(path)
		if (not file isa Error) and (file.hasPermission("r")) then
			fileContent = split(file.content, char(10))
			for line in fileContent
				if line.indexOf(":") != null then
					allHash.push(line)
				end if
			end for
		end if
	end for
	
	for hash in allHash
		obj = GetEntry(hash)
		
		outString = obj.user + ":"
		if obj.password != "" then 
			outString = outString + obj.password
		else 
			outString = outString + obj.hash
		end if
			
		print(outString)
	end for
	
end function
commandManager.registerCommand(Command.New({"name":"getpass", "description":"List all passwords accessible", "callback":@getPassCommandHandler}))

mailHackCommandHandler = function(params, extensionMediator)
	sessionManager = extensionMediator.getExtension("sessionManager")
	session = sessionManager.currentSession
    	handler = session.handler
    	address = params.address

	dictionaryManager = extensionMediator.getExtension("dictionaryManager")
	password = dictionaryManager.get()

	print("Starting dictionary attack...")
    	while not password isa Error 
    		mail = mail_login(address, password)
		if typeof(mail) != "string" then break
        	password = dictionaryManager.get()
	end while

	if typeof(mail) != "string" then 
		print("Attack successful. Password: " + password)
	else
		print("Attack failed, password not found")
	end if
end function
commandManager.registerCommand(Command.New({"name": "mailhack", "description": "Run a dictionary attack on the given email address", "parameters": [ Parameter.New({ "name": "address", "required": true })], "callback": @mailHackCommandHandler }))

// ============================================================================
//  5hell-style tooling: silentclean / rclean / prox / kraken / dig / batch
//  (ported in spirit to Nullshell's session-chain + remote-object model)
// ============================================================================

// --- silentclean -----------------------------------------------------------
// Local /var/system.log wipe on the CURRENT target, performed via remote file
// objects (same technique as corruptlogs: overwrite the log by moving an empty
// file on top of it). Run this immediately after acting as root so a passive
// trace never has a log to start from.
silentCleanCommandHandler = function(params, extensionMediator)
    sessionManager = extensionMediator.getExtension("sessionManager")
    session = sessionManager.currentSession
    handler = session.handler

    if handler.type() == "file" then return Error.New("Current target is a file session - no computer to clean")
    if handler.user != "root" then return Error.New("You must be root to wipe the logs")

    logFile = handler.getFile("/var/system.log")
    if logFile isa Error then return Error.New("Failed to reach /var/system.log")
    res = handler.createFile("/var/.sc_tmp")
    if res isa Error then return res
    res = handler.move("/var/.sc_tmp", "/var/system.log")
    if res isa Error then return res
    return "system.log wiped on " + handler.ip.public
end function
commandManager.registerCommand(Command.New({ "name": "silentclean", "description": "Wipe /var/system.log on the current target (root only)", "parameters": [], "callback": @silentCleanCommandHandler, "permissions": { "object": "computer", "privilege": "root" } }))

// --- rclean ----------------------------------------------------------------
// Remote log corruption against ANY target already in your session list, by
// index, WITHOUT switching to it or opening a terminal. Works purely through
// the target's remote file objects, so it leaves no interactive-shell footprint
// of its own. Omit the index to clean the current target.
rCleanCommandHandler = function(params, extensionMediator)
    sessionManager = extensionMediator.getExtension("sessionManager")
    sessions = sessionManager.sessions
    sessionIndex = params.sessionIndex

    if sessionIndex == null then
        session = sessionManager.currentSession
    else
        if not hasIndex(sessions, sessionIndex) then return Error.New("Invalid target index: " + sessionIndex)
        session = sessions[sessionIndex]
    end if
    handler = session.handler

    if handler.type() == "file" then return Error.New("Target is a file session - no computer to clean")
    if handler.user != "root" then return Error.New("Must be root on the target to corrupt its logs")

    logFile = handler.getFile("/var/system.log")
    if logFile isa Error then return Error.New("Failed to reach log file on target")
    res = handler.createFile("/var/.rc_tmp")
    if res isa Error then return res
    res = handler.move("/var/.rc_tmp", "/var/system.log")
    if res isa Error then return res
    return "Remotely corrupted logs on " + handler.ip.public + " (no terminal used)"
end function
commandManager.registerCommand(Command.New({ "name": "rclean", "description": "Corrupt /var/system.log on a target by index via remote objects (no terminal)", "parameters": [ Parameter.New({ "name": "sessionIndex", "required": false, "type": PARAMETER_TYPES.NUMBER }) ], "callback": @rCleanCommandHandler }))

// --- prox ------------------------------------------------------------------
// Establish routing through a proxy chain and drop into a terminal at the far
// end. Each hop is connected FROM the current shell, so traffic loops through
// every node in order (obscuring your origin IP). Pass hops as space-separated
//   user:password:ip[:port]
// specs. With no hops, just opens a terminal at the far end of the existing
// chain.
proxCommandHandler = function(params, extensionMediator)
    sessionManager = extensionMediator.getExtension("sessionManager")
    hopsRaw = params.hops

    if hopsRaw == null or hopsRaw == "" then
        handler = sessionManager.currentSession.handler
        if handler.type() != "shell" then return Error.New("Current target is not a shell")
        handler.activate()
        return
    end if

    hops = hopsRaw.split(" ")
    for hop in hops
        if hop == "" then continue
        parts = hop.split(":")
        if parts.len < 3 then return Error.New("Bad hop '" + hop + "' - expected user:password:ip[:port]")
        user = parts[0]
        password = parts[1]
        ip = parts[2]
        port = 22
        if parts.len >= 4 then port = to_int(parts[3])

        handler = sessionManager.currentSession.handler
        if handler.type() != "shell" then return Error.New("Current hop is not a shell - cannot route further")
        result = handler.connectTo(ip, port, user, password, "ssh")
        if result isa Error then return Error.New("Hop to " + ip + " failed: " + result.message)
        newSession = sessionManager.addSession(result, {})
        if newSession isa Error then return newSession
        sessionManager.setCurrentSession(sessionManager.getSessionIndex(newSession))
        print "Routed through " + ip + " (" + user + ")"
    end for

    handler = sessionManager.currentSession.handler
    if handler.type() == "shell" then handler.activate()
    return "Proxy chain established - terminal opened at far end"
end function
commandManager.registerCommand(Command.New({ "name": "prox", "description": "Route through a proxy chain (user:password:ip[:port] ...) and open a terminal at the far end", "parameters": [ RestParameter.New({ "name": "hops", "required": false, "default": "" }) ], "callback": @proxCommandHandler, "permissions": { "object": "shell" } }))

// --- kraken ----------------------------------------------------------------
// Manage the network of proxy shells you have compromised (every shell session
// except your pivot). Can propagate a file or folder to every node and launch a
// binary across all of them at once.
//   kraken list
//   kraken push <localPath> <remoteFolder>
//   kraken exec <remoteBinaryPath> [params]
krakenPropagate = function(fromHandler, srcPath, destFolder, toHandler)
    src = fromHandler.getFile(srcPath)
    if src isa Error then return src
    if src.type() == "FOLDER" then
        newFolderPath = destFolder + "/" + src.name()
        toHandler.createFolder(newFolderPath)
        children = src.children()
        if children isa Error then return children
        for child in children
            res = krakenPropagate(fromHandler, srcPath + "/" + child.name(), newFolderPath, toHandler)
            if res isa Error then return res
        end for
        return
    end if
    return fromHandler.putFileTo(srcPath, destFolder, toHandler)
end function

krakenCommandHandler = function(params, extensionMediator)
    sessionManager = extensionMediator.getExtension("sessionManager")
    action = params.action
    arg1 = params.arg1
    rest = params.rest

    pivotSession = sessionManager.pivotSession
    proxies = []
    for session in sessionManager.sessions
        if session.handler.type() != "shell" then continue
        if session == pivotSession then continue
        proxies.push(session)
    end for

    if action == "list" then
        if proxies.len == 0 then return "No proxy shells in the network"
        i = 0
        for session in proxies
            print "[" + i + "] " + session.handler.ip.public + " (" + session.handler.user + ")"
            i = i + 1
        end for
        return "Proxy network: " + proxies.len + " node(s)"
    end if

    if proxies.len == 0 then return Error.New("No proxy shells to operate on - build a chain first (ssh/prox)")

    if action == "push" then
        localPath = arg1
        destFolder = rest
        if localPath == null then return Error.New("Usage: kraken push <localPath> <remoteFolder>")
        if destFolder == null or destFolder == "" then destFolder = "/home/guest"
        pivotHandler = pivotSession.handler
        if pivotHandler.type() != "shell" then return Error.New("Pivot is not a shell - cannot scp from it")
        count = 0
        for session in proxies
            result = krakenPropagate(pivotHandler, localPath, destFolder, session.handler)
            if result isa Error then
                print "  " + session.handler.ip.public + ": " + result.message
            else
                print "  " + session.handler.ip.public + ": ok"
                count = count + 1
            end if
        end for
        return "Propagated to " + count + "/" + proxies.len + " node(s)"
    end if

    if action == "exec" then
        execPath = arg1
        execParams = rest
        if execParams == null then execParams = ""
        if execPath == null then return Error.New("Usage: kraken exec <remoteBinaryPath> [params]")
        count = 0
        for session in proxies
            result = session.handler.executeFile(execPath, execParams)
            if result isa Error then
                print "  " + session.handler.ip.public + ": " + result.message
            else
                print "  " + session.handler.ip.public + ": launched"
                count = count + 1
            end if
        end for
        return "Executed on " + count + "/" + proxies.len + " node(s)"
    end if

    return Error.New("Unknown action '" + action + "' (use: list, push, exec)")
end function
commandManager.registerCommand(Command.New({ "name": "kraken", "description": "Manage the proxy network: list | push <local> <remoteFolder> | exec <bin> [params]", "parameters": [ OptionsParameter.New({ "name": "action", "required": true, "options": { "list": "list", "push": "push", "exec": "exec" } }), Parameter.New({ "name": "arg1", "required": false }), RestParameter.New({ "name": "rest", "required": false, "default": "" }) ], "callback": @krakenCommandHandler }))

// --- dig -------------------------------------------------------------------
// Fully automated breach: resolve the target, scan its router for open ports,
// run metaxploit against each until a shell lands, switch to it, auto-wipe logs
// if we got root, then run a configurable post-exploitation batch file (one
// Nullshell command per line) from your own machine. Put rootkit uploads, privi-
// lege escalation, getpass, etc. in that batch to fully automate post-ex.
//   dig <address> [port] [batchPath]
digCommandHandler = function(params, extensionMediator)
    sessionManager = extensionMediator.getExtension("sessionManager")
    metaxploitManager = extensionMediator.getExtension("metaxploitManager")
    address = params.address
    port = params.port
    batchPath = params.batchPath

    resolved = address
    if not is_valid_ip(address) then
        lookup = nslookup(address)
        if lookup == "Not Found" then return Error.New("Could not resolve " + address)
        resolved = lookup
    end if
    print "[dig] target " + resolved

    candidatePorts = []
    if port != null then
        candidatePorts.push(to_int(port))
    else
        print "[dig] scanning ports..."
        router = Router.New(resolved)
        if router isa Error then return router
        devices = router.devices()
        for device in devices
            for p in device.value
                if p.open and p.port != 0 then candidatePorts.push(p.port)
            end for
        end for
        if candidatePorts.len == 0 then return Error.New("No open ports found on target")
    end if

    landed = null
    for cp in candidatePorts
        print "[dig] exploiting port " + cp + " ..."
        objects = metaxploitManager.hack(resolved, cp, null)
        if objects isa Error then
            print "  port " + cp + ": " + objects.message
            continue
        end if
        if objects.len == 0 then
            print "  port " + cp + ": no shell"
            continue
        end if
        sessionAddress = { "local": resolved, "public": resolved }
        for object in objects
            newSession = sessionManager.addSession(object, { "ip": sessionAddress })
            if not (newSession isa Error) then landed = newSession
        end for
        if landed != null then
            print "  port " + cp + ": shell obtained"
            break
        end if
    end for

    if landed == null then return Error.New("[dig] exploitation failed on all ports")

    sessionManager.setCurrentSession(sessionManager.getSessionIndex(landed))
    handler = landed.handler
    print "[dig] session as " + handler.user + "@" + handler.ip.public

    if handler.type() != "file" and handler.user == "root" then
        logFile = handler.getFile("/var/system.log")
        if not (logFile isa Error) then
            handler.createFile("/var/.dig_tmp")
            handler.move("/var/.dig_tmp", "/var/system.log")
            print "[dig] logs wiped"
        end if
    end if

    if batchPath != null then
        commandManager = extensionMediator.getExtension("commandManager")
        pivotHandler = sessionManager.pivotSession.handler
        batchFile = pivotHandler.getFile(batchPath)
        if batchFile isa Error then
            print "[dig] post-ex batch not found: " + batchPath
        else
            content = batchFile.content()
            if content isa Error then
                print "[dig] could not read batch: " + content.message
            else
                lines = content.split(char(10))
                for line in lines
                    line = line.trim
                    if line == "" then continue
                    if line.indexOf("#") == 0 then continue
                    print "[dig] > " + line
                    commandManager.executeCommand(line)
                end for
            end if
        end if
    end if

    print "[dig] done"
end function
commandManager.registerCommand(Command.New({ "name": "dig", "description": "Automated breach: scan, exploit, open shell, auto-clean, run post-ex batch", "parameters": [ Parameter.New({ "name": "address", "required": true }), Parameter.New({ "name": "port", "required": false, "type": PARAMETER_TYPES.NUMBER }), Parameter.New({ "name": "batchPath", "required": false }) ], "callback": @digCommandHandler }))

// --- batch -----------------------------------------------------------------
// Run a file of Nullshell commands (one per line, # for comments) from your own
// machine. The post-exploitation engine behind dig, usable standalone.
batchCommandHandler = function(params, extensionMediator)
    sessionManager = extensionMediator.getExtension("sessionManager")
    commandManager = extensionMediator.getExtension("commandManager")
    path = params.path

    handler = sessionManager.pivotSession.handler
    file = handler.getFile(path)
    if file isa Error then return file
    content = file.content()
    if content isa Error then return content
    lines = content.split(char(10))
    for line in lines
        line = line.trim
        if line == "" then continue
        if line.indexOf("#") == 0 then continue
        print "> " + line
        commandManager.executeCommand(line)
    end for
end function
commandManager.registerCommand(Command.New({ "name": "batch", "description": "Run a file of Nullshell commands line-by-line from your own machine", "parameters": [ Parameter.New({ "name": "path", "required": true }) ], "callback": @batchCommandHandler }))

weaverCommandHandler = function(params, extensionMediator)
    sessionManager = extensionMediator.getExtension("sessionManager")
    session = sessionManager.currentSession
    handler = session.handler
    mode = params.mode
    weaverUser = getUserFromHandler(handler)
    if weaverUser == "root" then path = "/root/.weaver_off" else path = "/home/" + weaverUser + "/.weaver_off"

    if mode == "off" then
        result = handler.createFile(path)
        if result isa Error then return result
        return "Weaver self-redaction disabled (system.log entries will no longer be scrubbed)."
    else if mode == "on" then
        file = handler.getFile(path)
        if file isa Error then return "Weaver self-redaction already enabled."
        result = handler.delete(path)
        if result isa Error then return result
        return "Weaver self-redaction enabled."
    else if mode == "status" then
        file = handler.getFile(path)
        if file isa Error then return "Weaver self-redaction: ENABLED"
        return "Weaver self-redaction: DISABLED"
    else
        return Error.New("Invalid mode. Valid values are 'on', 'off', or 'status'.")
    end if
end function
commandManager.registerCommand(Command.New({ "name": "weaver", "description": "Enable, disable, or check the status of Weaver's self-redaction on system.log", "parameters": [ Parameter.New({ "name": "mode", "required": true }) ], "callback": @weaverCommandHandler }))
