exploitScanCommandHandler = function(params, extensionMediator)
    address = params.address
    port = params.port
    options = params.options

    libManager = extensionMediator.getExtension("libManager")

    // Fixed from upstream Viper: the port-required check used to run AFTER
    // calling metaxploitManager.hack(), so a remote-IP scan with no port ever
    // reached the friendly "Port is required" error -- it crashed first inside
    // the native metaxploit.so getLib() call with a raw "Port is null" runtime
    // error instead. Validate before calling hack().
    if is_valid_ip(address) and port == null then return Error.New("Port is required")

    metaxploitManager = extensionMediator.getExtension("metaxploitManager")
    objects = metaxploitManager.hack(address, port, options)

    if objects isa Error then return objects

    if not is_valid_ip(address) then
        lib = libManager.getCurrentLib("metaxploit")
        sessionAddress = lib.data.ip
    else
        resolvedAddress = address
        if is_lan_ip(address) then resolvedAddress = libManager.getCurrentLib("metaxploit").data.ip.public
        router = Router.New(resolvedAddress)
        if router isa Error then return router
        devices = router.devices()

        handleFindPort = function(device)
            for p in device.value
                if (p.open or p.port == 8080) and p.port == to_int(port) then return true
            end for
            return false
        end function
        device = find(devices, @handleFindPort)
        if device == null then return Error.New("Port is not open/found")
        sessionAddress = {             "local": device.key,             "public": resolvedAddress         }
    end if

    sessionManager = extensionMediator.getExtension("sessionManager")
    handleAddSessionObject = function(object)
        sessionManager.addSession(object, { "ip": sessionAddress })
    end function
    forEach(objects, @handleAddSessionObject)
end function
commandManager.registerCommand(Command.New({     "name": "exploitscan",     "description": "Scan the network for exploits",     "parameters": [         Parameter.New({             "name": "address",             "required": true         }),         Parameter.New({             "name": "port",             "required": false         }),         Parameter.New({             "name": "options",             "required": false         })     ],     "callback": @exploitScanCommandHandler }))

